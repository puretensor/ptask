[Unit]
Description=pTask accountability — escalation + dispatch
Documentation=https://github.com/puretensor/ptask
ConditionPathExists=%h/puretensor-tasks/.env
After=network-online.target
Wants=network-online.target
OnFailure=ptask-failure-alert@%n.service

[Service]
Type=oneshot
EnvironmentFile=%h/puretensor-tasks/.env
ExecStart=%h/.cargo/bin/pt accountability run
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
StandardOutput=journal
StandardError=journal
TimeoutStartSec=5min
