[Unit]
Description=pTask nightly JSONL export (git-committed projection of the spine)
OnFailure=ptask-failure-alert@%n.service

[Service]
Type=oneshot
EnvironmentFile=%h/puretensor-tasks/.env
ExecStart=%h/.cargo/bin/pt export --git
Nice=15
IOSchedulingClass=best-effort
StandardOutput=journal
StandardError=journal
# A oneshot has no start timeout by default: a hung `git` (stale index.lock,
# stuck mount) would hang the export forever without failing or alerting.
TimeoutStartSec=10min
