[Unit]
Description=pTask distillation pipeline — every 6 hours
Documentation=https://github.com/puretensor/ptask

[Timer]
# Same cadence as the legacy puretensor-tasks-distill.timer: 00:00, 06:00,
# 12:00, 18:00 UTC with a 5-minute random jitter to spread fleet load.
OnCalendar=*-*-* 00,06,12,18:00:00
RandomizedDelaySec=300
Persistent=true
Unit=ptask-distill.service

[Install]
WantedBy=timers.target
