[Unit]
Description=pTask native distillation — hourly micro-runs
Documentation=https://github.com/puretensor/ptask

[Timer]
# Hourly delta runs (v2.1.0): the native pipeline only consumes NEW
# raw_items, so each run is small and cheap — no more 60-day re-scans.
OnCalendar=*-*-* *:15:00
RandomizedDelaySec=300
Persistent=true
Unit=ptask-distill.service

[Install]
WantedBy=timers.target
