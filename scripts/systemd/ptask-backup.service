[Unit]
Description=pTask nightly SQLite backup to Ceph
Documentation=https://github.com/puretensor/ptask
ConditionPathExists=%h/puretensor-tasks/tasks.db
After=network-online.target
Wants=network-online.target
OnFailure=ptask-failure-alert@%n.service

[Service]
Type=oneshot
ExecStart=%h/ptask/scripts/ptask-backup.sh
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
# Keep stderr/stdout, journald captures it.
StandardOutput=journal
StandardError=journal
# A oneshot has no start timeout by default: a hang never fails the unit,
# so OnFailure never fires and later nightly runs never start. Must exceed
# the script's own worst case (two legs of per-step timeouts, 1780 s with
# the defaults; arithmetic in ptask-backup.sh) plus the local snapshot, so a
# hung nearby leg is cut off by the script and the off-site leg still runs.
TimeoutStartSec=40min
