[Unit]
Description=pTask weekly backup restore drill (litestream + nightlies)
Documentation=https://github.com/puretensor/ptask
ConditionPathExists=%h/puretensor-tasks/tasks.db
After=network-online.target
Wants=network-online.target
OnFailure=ptask-failure-alert@%n.service

[Service]
Type=oneshot
ExecStart=%h/ptask/scripts/ptask-restore-verify.sh
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
StandardOutput=journal
StandardError=journal
TimeoutStartSec=10min
