[Unit]
Description=pTask HTTP sync API (Rust pt serve)
Documentation=https://github.com/puretensor/ptask
After=network-online.target
Wants=network-online.target

# Example unit binds loopback. For LAN/VPN clients, change --bind to a
# private interface address (not 0.0.0.0) and set both PTASK_API_TOKEN and
# PTASK_DASH_PASS in the EnvironmentFile. Only set
# PTASK_ALLOW_UNAUTHENTICATED=1 for isolated tests.
# To embed the authenticated dashboard in one trusted HTTPS parent, set
# PTASK_DASH_FRAME_ANCESTOR to that exact origin. The default remains DENY.
[Service]
Type=simple
EnvironmentFile=%h/puretensor-tasks/.env
ExecStart=%h/.cargo/bin/pt serve --bind 127.0.0.1:9501
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
