[Unit]
Description=pTask accountability — every 15 minutes
Documentation=https://github.com/puretensor/ptask

[Timer]
# Mirrors the legacy puretensor-tasks-accountability.timer cadence. The
# accountability engine itself enforces 22:00 — 08:00 UTC quiet hours; this
# timer fires regardless and run_check returns a no-op when appropriate.
OnCalendar=*:0/15
RandomizedDelaySec=60
Persistent=true
Unit=ptask-accountability.service

[Install]
WantedBy=timers.target
