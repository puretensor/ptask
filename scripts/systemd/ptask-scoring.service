[Unit]
Description=pTask scoring — composite priority recompute
Documentation=https://github.com/puretensor/ptask
After=network-online.target

[Service]
Type=oneshot
ExecStart=%h/.cargo/bin/pt scoring run
Nice=15
IOSchedulingClass=best-effort
IOSchedulingPriority=7
StandardOutput=journal
StandardError=journal
TimeoutStartSec=5min
