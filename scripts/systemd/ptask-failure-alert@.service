[Unit]
Description=pTask failure alert — Telegram notification for %i
Documentation=https://github.com/puretensor/ptask

# Attached via OnFailure= on the oneshot ptask units. A failing
# accountability/distill/backup run must reach the operator even when
# Prometheus is down — this is the zero-dependency last-resort lane.
# Uses the same bot credentials the accountability dispatcher uses.

[Service]
Type=oneshot
EnvironmentFile=%h/puretensor-tasks/.env
ExecStart=/usr/bin/curl -sS --max-time 20 \
    --data-urlencode "chat_id=${TELEGRAM_CHAT_ID}" \
    --data-urlencode "text=🔴 ptask unit FAILED on %H: %i — journalctl --user -u %i -n 30" \
    "https://api.telegram.org/bot${TELEGRAM_BOT_TOKEN}/sendMessage"
StandardOutput=journal
StandardError=journal
