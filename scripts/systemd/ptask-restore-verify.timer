[Unit]
Description=pTask daily backup restore drill

[Timer]
# Daily 05:30 UTC — after the nightly backup (so the freshness checks see
# yesterday's file) and before the 06:00 distill run.
#
# Daily, not Monday-only (it was `Mon *-*-* 05:30:00` until 2026-10-30): the
# fleet's generic NodeTextfileStale rule (mon2 alerts.yml) treats any
# textfile older than 26 h as a dead writer, so a weekly full drill left
# ptask_restore_verify_full.prom stale six days out of seven and paged every
# week from Tuesday on. The full drill costs 12 s and ~25 MB of ssh copy, so
# running it daily is cheaper than the false alert. The weekly-depth rule
# PtaskRestoreVerifyStale (9 days for mode="full") still applies and still
# catches a drill that stops passing; mode="replica" keeps its own daily
# 04:40 slot and 30 h window.
OnCalendar=*-*-* 05:30:00
Persistent=true
RandomizedDelaySec=300

[Install]
WantedBy=timers.target
