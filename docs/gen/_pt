(( $+functions[_pt_commands] )) ||
_pt_commands() {
    local commands; commands=(
'add:Create a new task' \
'list:List tasks' \
'done:Mark a task done (by PT-N or title substring)' \
'priority:Promote/demote a task'\''s priority (critical|urgent|high|normal|low or 1..=5)' \
'edit:Edit task fields' \
'reopen:Reopen a completed/dismissed task (status → pending)' \
'show:Show one task'\''s full row + side-table detail' \
'dismiss:Dismiss a task (soft close, status → dismissed; reversible via reopen)' \
'rm:Delete a task permanently (hard delete + tombstone)' \
'next:Show ready-to-start tasks (all dependencies done)' \
'view:Manage saved views' \
'tui:Launch the terminal UI (ratatui)' \
'serve:Run the HTTP server (sync API, capture, webhooks, metrics)' \
'bot:Run the Telegram bot (Bot API long-poll)' \
'branch:Print a Linear-style branch name for a task' \
'distill:Run the distillation pipeline (Python subprocess shim until v0.9)' \
'accountability:Run one accountability cycle (escalation + Telegram/email)' \
'scoring:Recompute composite priority scores for all active tasks' \
